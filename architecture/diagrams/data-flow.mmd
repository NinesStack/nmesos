    SingularityModels --> SingularityOps
    DockerModels --> DockerOps
    
    SingularityOps --> SingularityAPI
    SingularityAPI --> SingularityOps
    
    SingularityOps --> OutputFormat
    DockerOps --> OutputFormat
    
    %% Command Chain Data Flow
    subgraph ChainFlow["🔗 Command Chain Flow"]
        ChainConfig[After Deploy Config<br/>• on_success: List of DeployJob<br/>• on_failure: Option of DeployJob]
        
        ChainValidation[Chain Validation<br/>• Cycle Detection<br/>• Dependency Resolution]
        
        ChainExecution[Sequential Execution<br/>• Breadth-first processing<br/>• Failure handling]
    end
    
    CmdConfigModel --> ChainConfig
    ChainConfig --> ChainValidation
    ChainValidation --> ChainExecution
    ChainExecution --> SingularityOps
    
    %% Data Validation Flow
    subgraph ValidationFlow["✅ Validation Flow"]
        ResourceValidation[Resource Validation<br/>• CPU/Memory limits<br/>• Instance counts]
        
        DeprecationCheck[Deprecation Check<br/>• Env var expiration<br/>• Grace periods]
        
        VersionCheck[Version Compatibility<br/>• nmesos_version<br/>• API compatibility]
        
        ConfigIntegrity[Config Integrity<br/>• Required fields<br/>• Type validation]
    end
    
    CmdConfigModel --> ResourceValidation
    CmdConfigModel --> DeprecationCheck
    ConfigModel --> VersionCheck
    ConfigModel --> ConfigIntegrity
    
    %% Output Data Flow
    subgraph OutputFlow["📤 Output Flow"]
        TerminalOutput[Terminal Output<br/>• Colored formatting<br/>• Progress animations<br/>• Error messages]
        
        LogOutput[Log Output<br/>• Debug information<br/>• Audit trail]
        
        FileOutput[File Output<br/>• docker-compose.yml<br/>• .env files]
    end
    
    OutputFormat --> TerminalOutput
    OutputFormat --> LogOutput
    DockerOps --> FileOutput
    
    %% Environment Variable Processing
    subgraph EnvVarFlow["🌍 Environment Variable Flow"]
        EnvVarMerge[Environment Variable Merge<br/>• Common env_vars<br/>• Environment specific<br/>• Executor env_vars]
        
        EnvVarValidation[Env Var Validation<br/>• Missing keys detection<br/>• Deprecation tracking]
        
        EnvVarInjection[Env Var Injection<br/>• Container runtime<br/>• Executor configuration]
    end
    
    CmdConfigModel --> EnvVarMerge
    EnvVarMerge --> EnvVarValidation
    EnvVarValidation --> EnvVarInjection
    EnvVarInjection --> SingularityModels
    
